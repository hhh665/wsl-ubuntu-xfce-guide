#!/usr/bin/env bash
set -euo pipefail
[[ $EUID -ne 0 ]] || { echo 'Start the desktop as a normal Linux user.' >&2; exit 1; }
umask 077
runtime_base="${XDG_RUNTIME_DIR:-/tmp/wsl-desktop-$UID}"
runtime_dir="$runtime_base/wsl-xfce-desktop"
mkdir -p "$runtime_dir" "$HOME/.local/state/wsl-xfce-desktop"
chmod 700 "$runtime_dir"
exec 9>"$runtime_dir/desktop.lock"
flock -n 9 || { echo 'Desktop already running. Restore its Windows window.'; exit 0; }
exec >>"$HOME/.local/state/wsl-xfce-desktop/session.log" 2>&1
printf '\n--- Desktop started: %s ---\n' "$(date --iso-8601=seconds)"
cd "$HOME"
parent_display="${DISPLAY:-:0}"
window_title="Ubuntu Desktop (Xfce) [${WSL_DISTRO_NAME:-WSL}]"
geometry="${WSL_XFCE_GEOMETRY:-1600x900}"
[[ "$geometry" =~ ^[0-9]+x[0-9]+$ ]] || { echo 'Invalid desktop geometry.'; exit 1; }
# A delay helped avoid input initialization failures in the observed environment.
# It is a workaround, not a promise that every WSLg version has initialized.
sleep 2
display_number=1
while [[ -e "/tmp/.X${display_number}-lock" || -S "/tmp/.X11-unix/X${display_number}" ]]; do
    ((display_number+=1))
    ((display_number <= 20)) || { echo 'No unused X display found.'; exit 1; }
done
auth_file="$runtime_dir/Xauthority"
touch "$auth_file"
cookie="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
xauth -f "$auth_file" add ":$display_number" . "$cookie"
xephyr_pid=''
session_pid=''
cleanup() {
    trap - EXIT HUP INT TERM
    # Close the X connection first so graphical clients can finish promptly.
    if [[ -n "$xephyr_pid" ]]; then kill "$xephyr_pid" 2>/dev/null || true; fi
    if [[ -n "$session_pid" ]]; then kill "$session_pid" 2>/dev/null || true; fi
    if [[ -n "$xephyr_pid" ]]; then wait "$xephyr_pid" 2>/dev/null || true; fi
    if [[ -n "$session_pid" ]]; then wait "$session_pid" 2>/dev/null || true; fi
    rm -f "$auth_file" "$runtime_dir/desktop.pid" "$runtime_dir/display"
}
trap cleanup EXIT HUP INT TERM
DISPLAY="$parent_display" Xephyr ":$display_number" \
    -screen "$geometry" -resizeable -noreset -nolisten tcp -dpi 96 -no-host-grab \
    -title "$window_title" -auth "$auth_file" &
xephyr_pid=$!
export DISPLAY=":$display_number" XAUTHORITY="$auth_file"
for attempt in {1..100}; do
    if xdpyinfo >/dev/null 2>&1; then break; fi
    kill -0 "$xephyr_pid" 2>/dev/null || { echo 'Xephyr could not start.'; exit 1; }
    sleep 0.1
done
xdpyinfo >/dev/null
printf '%s\n' "$$" >"$runtime_dir/desktop.pid"
printf '%s\n' "$DISPLAY" >"$runtime_dir/display"
unset WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS SESSION_MANAGER
export XDG_SESSION_TYPE=x11 XDG_CURRENT_DESKTOP=XFCE XDG_SESSION_DESKTOP=xfce
export DESKTOP_SESSION=xfce GDK_BACKEND=x11 QT_QPA_PLATFORM=xcb
export LANG=zh_CN.UTF-8 LANGUAGE=zh_CN:zh
dbus-run-session -- startxfce4 &
session_pid=$!
wait "$session_pid"
